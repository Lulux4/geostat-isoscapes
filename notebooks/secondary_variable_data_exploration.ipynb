    "fig,ax = putils.plot_isoscape_latlon_platecarree(itrace_ds.sel(time=time).d18Op,time=f'{utils.get_yrBP_from_itrace_time(time, start_year=sim_start_yr):.2f} yr BP',countries_borders=True) # type:ignore\n",
