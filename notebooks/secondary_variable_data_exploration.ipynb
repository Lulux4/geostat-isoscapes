   "source": [
    "import geopandas as gpd\n",
    "fn_countries = \"../data/shapefiles/ne_110m_admin_0_countries/ne_110m_admin_0_countries.shp\"\n",
    "world = gpd.read_file(fn_countries)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "857ec2de",
   "metadata": {},
   "outputs": [],
   "source": [
    "countries = world.loc[world['CONTINENT'].isin(['Europe','Asia']),'NAME'].to_list()\n",
    "region_da = utils.mask_country_shape(delta18,country_names=countries)\n",
    "# this function will be directly applied in the preprocessing of itrace data."
   ]
