   "source": [
    "import pandas as pd\n",
    "from geostat_isoscapes_tools import geostat_utils as gutils, plot_utils as putils, utils\n",
    "import matplotlib.pyplot as plt \n",
    "import numpy as np\n",
    "import skgstat as skg\n",
    "from tqdm import tqdm\n",
    "from scipy.spatial.distance import pdist\n",
    "import seaborn as sns\n",
    "import json\n",
    "\n",
    "sns.set_style('dark')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8f49831e",
   "metadata": {},
   "source": [
    "## Chen et al. dataset"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "88fd5b36",
   "metadata": {},
   "source": [
    "**[Chen dataset](https://zenodo.org/records/7306199) (download the *.nc* file).**\n",
    "\n",
    "This dataset is not a direct output from isotope-enabled GCMs. Instead, it has been generated through data fusion and bias correction techniques based on GCM outputs. In other words, post-processing methods were applied to the model outputs to bring the simulations closer to observational data. This dataset is 1870–2017 at a monthly scale.\n",
    "\n",
    "First, we import useful libraries and read the netCTF4 file with xarray to get a Dataset object. "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "87ff4169",
   "metadata": {},
   "outputs": [],
   "source": [
    "fn = '../data/modern/PrecipOxygenIso_mainlandCHINA_1870to2017_v2.nc'\n",
    "\n",
    "file = utils.load_xarray_datarray(fn)\n",
    "d18Op = file.d18Op\n",
    "\n",
    "# make the time dimension a datetime index, starting from 1870-01-01, with monthly frequence so that time 1 becomes 1870-01-31, etc.\n",
    "time_index = pd.date_range(start='1870-01-31', periods=d18Op.sizes['time'], freq='ME')\n",
    "d18Op = d18Op.assign_coords(time=time_index)\n",
    "# transpose so that the order of the dims is lat/lon and not lon/lat (pb with plotting fct and flattening otherwise)\n",
    "d18Op = d18Op.transpose('time','lat','lon')"
   ]
  },
