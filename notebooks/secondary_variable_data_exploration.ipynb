    "time_ = range(0,len(delta18.time))\n",
    "delta18 = delta18.assign_coords(time=('time',time_))\n",
    "delta18 = delta18.assign_coords(time = delta18.time.assign_attrs(units=\"months since last month of 12 kyr BP\"))\n",
    "\n",
    "delta18.time"
   ]
