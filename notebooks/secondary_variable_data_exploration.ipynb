   "metadata": {},
   "source": [
    "#### Directional variograms (gstat)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "cc1edffa",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 2000x1000 with 4 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Range in direction 0°: 17.43939884403119\n",
      "Range in direction 45°: 13.792435189966538\n",
      "Range in direction 90°: 7.11890910534521\n",
      "Range in direction 135°: 14.112149723555621\n",
      "Anisotropy Ratio: 2.449729106800489\n",
      "Anisotropy Direction: 0°\n"
     ]
    }
   ],
   "source": [
    "coords_proj, vals_s = gutils.get_projected_coords_and_vals(d18Op, time=time, epsg=\"EPSG:3857\")\n",
    "\n",
    "resid, params = gutils.detrend_data_plane(coords_proj,vals_s)\n",
    "\n",
    "# # show the map of data and residuals again \n",
    "# fig, ax = putils.plot_projected_data(coords_proj,vals_s,'Mercator')\n",
    "# plt.show()\n",
    "# fig,ax = putils.plot_projected_data(coord_proj,resid,'Mercator')\n",
    "# plt.show()\n",
    "\n",
    "# Compute directional variogram\n",
    "directions = [0,45,90,135]\n",
    "ranges = []\n",
    "fig, axes = plt.subplots(2, 2, figsize=(20, 10))\n",
    "axes = axes.flatten()\n",
    "for i, direction in enumerate(directions):\n",
    "    V_dir = skg.DirectionalVariogram(coords_proj,resid,n_lags=30,maxlag=maxlag,\n",
    "                                     model='spherical',use_nugget=True,normalize=False,\n",
    "                                     azimuth=direction,tolerance = 22.5 )\n",
    "    ranges.append(V_dir.parameters[1])\n",
    "    V_dir.plot(axes=axes[i], show=False, grid=True)\n",
    "    axes[i].set_title(f'Directional Variogram - {direction}°')\n",
    "plt.suptitle('Directional Variograms')\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "for dir, r in zip(directions, ranges):\n",
    "    print(f'Range in direction {dir}°: {r}')\n",
    "anisotropy_ratio = max(ranges) / min(ranges)\n",
    "print(f'Anisotropy Ratio: {anisotropy_ratio}')\n",
    "max_range_index = ranges.index(max(ranges))\n",
    "print(f'Anisotropy Direction: {directions[max_range_index]}°')\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "5e981c0d",
   "metadata": {},
   "source": [
    "### Global variograms"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ee8e2ae0",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "-> Adding external variables ['ele'].\n",
      "   > elevation data will be taken from file ../data/elevation/ETOPO_2022_v1_60s_N90W180_surface.nc\n"
     ]
    },
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      " 86%|████████▌ | 1520/1776 [30:12<05:38,  1.32s/it]"
     ]
    }
   ],
   "source": [
    "# convert the xarray into dataframe\n",
    "df = d18Op.to_dataframe(name='d18Op').reset_index().dropna()\n",
    "df = gutils.add_external_variables_to_lonlat_df(df,variables=['ele'])\n",
    "# df = df[( df['time'].dt.month.isin([10,11,12,1,2,3,4]))] # Moonsoon = May to September\n",
    "\n",
    "df['x'], df['y'] = gutils.project_coords(df['lon'].values, df['lat'].values, epsg=\"EPSG:3857\")\n",
    "\n",
    "bins, bin_count, gammas = None, None, []\n",
    "for t, g in tqdm(df.groupby('time')):\n",
    "    if g['d18Op'].notna().sum() < 30:\n",
    "        continue\n",
    "    try:\n",
    "        b, g_exp, bin_count,_,_ = gutils.variogram_with_gstat(g,quantity='d18Op',trend='multiple_linear_lat_ele',maxlag='median',return_Variogram_object=False,verbose=False) # type: ignore\n",
    "        # at each time step the locations stay the same, so bins and bin counts are constant\n",
    "        if bins is None:\n",
    "            bins = b\n",
    "            bin_count = bin_count\n",
    "        # append the semivariances to the list\n",
    "        gammas.append(g_exp)\n",
    "    except Exception as e:\n",
    "        print(f\"Skipped {t}: {e}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "e5d58779",
   "metadata": {},
   "source": [
    "**Motivation for computing each variogram separetly**:\n",
    "\n",
    "There is the same number of pairs at each timestep. Hence, if the variogram is computed for each timestep separately and then the mean is taken, it is equivalent to computing the variogram directly with all pairs from all timesteps (which would require an immense amount of memory). \n",
    "\n",
    "This is due to the fact that the value of the variogram at one bin is the mean semivariance at lag h, and a sum of means is the mean of the sum only if each sum has the same number of elements."
   ]
  },
