   "source": [
    "### Note that using lat or |lat| combined with the Relu (max(0,lat)) do not change the fit : algebraically, they generate the same space of PW linear functions with a knot at 0.\n",
    "### See the plot below to check this\n",
    "lats = np.arange(180)-90\n",
    "detrended_df, results_dict = gutils.detrend_multiple_linear_regression(df,features='lat_latReLU')\n",
    "plt.plot(lats,results_dict['parameters']['lat']*lats+results_dict['parameters']['latReLU']*np.maximum(0,lats),label='no abs')\n",
    "detrended_df, results_dict = gutils.detrend_multiple_linear_regression(df,features='latabs_latReLU')\n",
    "plt.plot(lats,results_dict['parameters']['|lat|']*np.abs(lats)+results_dict['parameters']['latReLU']*np.maximum(0,lats),'--',label='abs')\n",
    "plt.legend()\n",
    "plt.grid()\n",
    "plt.show()"
   ]
  },
