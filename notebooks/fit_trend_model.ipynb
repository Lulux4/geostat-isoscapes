   "source": [
    "from geostat_isoscapes_tools import utils, geostat_utils as gutils, plot_utils as putils\n",
    "import matplotlib.pyplot as plt \n",
    "import seaborn as sns\n",
    "import numpy as np\n",
    "import pandas as pd \n",
    "\n",
    "sns.set_style('dark')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "9321b986",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "loading itrace files\n",
      "This dataset contains  12000  time steps.\n",
      "  Loading files for total precipitation info\n",
      "   rain file info : {'long_name': 'atmospheric rain', 'units': 'mm/s', 'cell_methods': 'time: mean'}\n"
     ]
    }
   ],
   "source": [
    "countries = None #('countries',['China'])\n",
    "itrace_xrds = gutils.get_preprocessed_itrace_data(\n",
    "    data_folder="/media/luluxette/T7_Shield/pdm/iTrace/",\n",
    "    include_snow=True, \n",
    "    regions=countries, \n",
    "    P = True,\n",
    "    format = 'xr') # default : load 12kyr simulation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "2ee96e35",
   "metadata": {},
   "outputs": [],
   "source": [
    "nlags=20"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "e271c7e7",
   "metadata": {},
   "source": [
    "### **Detailed procedure for a single time step**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "19a713a4",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x500 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "time=itrace_xrds['time'].values[-1000]#-3000\n",
    "\n",
    "fig,ax = putils.plot_isoscape_latlon_platecarree(itrace_xrds.sel(time=time).d18Op,time=f'{utils.get_yrBP_from_itrace_time(time):.2f} yrBP',countries_borders=True) # type:ignore\n",
    "# plt.savefig('../output/data_exploration/itrace_map_example_chinazoom.png',dpi=500)\n",
    "plt.show() \n",
    "# Compute Variogram\n",
    "# V = skg.Variogram(coords_proj, vals_s, n_lags=20, maxlag='median', model='spherical', use_nugget=True, normalize=False)\n",
    "# ref_bins = V.bins\n",
    "#\n",
    "df=itrace_xrds.sel(time=time).to_dataframe().reset_index().dropna(subset=['d18Op','P']) # type:ignore\n",
    "df['x'], df['y'] = gutils.project_coords(df['lon'].values, df['lat'].values, epsg=\"EPSG:3857\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c130be56",
   "metadata": {},
   "source": [
    "#### **Variogram on raw data**"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "0569acb1",
   "metadata": {},
   "source": [
    "First, let us see whether the data needs to be detrended or is already stationary. "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "81a1a880",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x500 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "V,results = gutils.variogram_with_gstat(df,\n",
    "                                quantity='d18Op',\n",
    "                                trend=None,\n",
    "                                maxlag=1.2e7,\n",
    "                                nlags=nlags,\n",
    "                                return_Variogram_object=True,\n",
    "                                #model='spherical+gaussian'\n",
    "                                )\n",
    "ref_bins = V.bins\n",
    "\n",
    "fig,ax = putils.plot_variogram_from_bins_and_gamma(V.bins,\n",
    "                                                   V.experimental,\n",
    "                                                   f'{time:.2f} yr BP',\n",
    "                                                   V.bin_count,\n",
    "                                                   min_pairs=30,\n",
    "                                                #    plot_model=False,\n",
    "                                                #    model_name=V._model_name,\n",
    "                                                #    model_fct=V.fitted_model\n",
    "                                                   ) #type:ignore\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "29035b7a",
   "metadata": {},
   "source": [
    "The variogram clearly has no sill, this means the data is non stationary and trends need to be removed.\n",
    "We can try to fit a plane to the data in order to remove a linear drift, if any."
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8a265cc6",
   "metadata": {},
   "source": [
    "#### **Trend modelled as a simple plane**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "67288036",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "r^2 of the trend model (plane) is: 0.2037863273895829\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x500 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x500 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x500 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Visualize the trend found by fitting a plane to the data :\n",
    "vals = df['d18Op'].values\n",
    "XY = np.column_stack((df['x'], df['y']))\n",
    "resid,results = gutils.detrend_data_plane(XY,vals)\n",
    "df['resid_plane']=resid\n",
    "df['trend_plane']=df['d18Op']-df['resid_plane']\n",
    "\n",
    "# Rsquare:\n",
    "sst = np.sum((vals - np.mean(vals))**2)\n",
    "ssr = np.sum(resid**2)\n",
    "r2 = 1 - ssr / sst\n",
    "print('r^2 of the trend model (plane) is:', r2)\n",
    "\n",
    "fig, ax = putils.plot_isoscape_latlon_platecarree_df(df[['lat','lon','d18Op']],time='trend=plane',title='d18Op data',qty_col='d18Op')\n",
    "plt.show()\n",
    "fig, ax = putils.plot_isoscape_latlon_platecarree_df(df[['lat','lon','trend_plane']],time='trend=plane',title='d18Op spatial trend',qty_col='trend_plane')\n",
    "plt.show()\n",
    "fig, ax = putils.plot_isoscape_latlon_platecarree_df(df[['lat','lon','resid_plane']],time='trend=plane',title='d18Op residuals',qty_col='resid_plane')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "a489f2df",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x500 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "V, results = gutils.variogram_with_gstat(df,\n",
    "                                quantity='d18Op',\n",
    "                                trend='plane',\n",
    "                                centers=ref_bins,\n",
    "                                return_Variogram_object=True,\n",
    "                                model='spherical'\n",
    "                                )\n",
    "\n",
    "parameters_dict= gutils.get_vario_parameters_dict(V.parameters)\n",
    "\n",
    "fig,ax = putils.plot_variogram_from_bins_and_gamma(V.bins,\n",
    "                                                   V.experimental,\n",
    "                                                   f'{utils.get_yrBP_from_itrace_time(time):.2f} yr BP',\n",
    "                                                   V.bin_count,\n",
    "                                                   min_pairs=30,\n",
    "                                                   plot_model=False,\n",
    "                                                   model_name=V._model_name,\n",
    "                                                   model_fct=V.fitted_model,\n",
    "                                                   model_params=parameters_dict) #type:ignore\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a9bceb7c",
   "metadata": {},
   "source": [
    "The linear plane fitted explained only <50% variance of the data, and unfortunately our data seems to have more complex trends than a linear drift, which is uninformed of the physics.\n",
    "\n",
    "Physically, a known trend in delta18O values is the trend linked to the latitude : going away from tropical latitudes is correlate to a decrease in the delta 18O values.\n",
    "\n",
    "Hence, we can try to fit and remove a multilinear trend model based on the predictor 'latitude' and 'latitude squared'"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "43e148c6",
   "metadata": {},
   "source": [
    "#### **Physically informed multilinear trend (multilinear regression)**"
   ]
  },
