    "# Now let us fit our trend model including this feature\n",
    "trend = trend+'_ele'\n",
    "detrended_df, results_dict = gutils.detrend_multiple_linear_regression(df,features=trend)\n",
    "\n",
    "fig, ax = putils.plot_isoscape_latlon_platecarree_df(detrended_df[['lat','lon','d18Op']],time=f'trend={trend}',title='d18Op data',qty_col='d18Op')\n",
    "plt.show()\n",
    "fig, ax = putils.plot_isoscape_latlon_platecarree_df(detrended_df[['lat','lon','trend']],time=f'trend={trend}',title='d18Op spatial trend',qty_col='trend')\n",
    "plt.show()\n",
    "fig, ax = putils.plot_isoscape_latlon_platecarree_df(detrended_df[['lat','lon','residual']],time=f'trend={trend}',title='d18Op residuals',qty_col='residual')\n",
    "plt.show()\n",
    "\n",
    "res_df = gutils.multiple_linear_result_dict_to_df(result_dict=results_dict)\n",
    "\n",
    "print('R2=',results_dict['r2'])\n",
    "res_df"
   ]
